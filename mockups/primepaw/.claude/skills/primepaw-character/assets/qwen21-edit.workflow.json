{
  "save": {"_meta": {"title": "Save Image"}, "class_type": "SaveImageAdvanced",
           "inputs": {"filename_prefix": "__PREFIX__", "format": "png", "format.bit_depth": "8-bit", "format.input_color_space": "sRGB", "images": ["decode", 0]}},
  "load": {"_meta": {"title": "Load Image"}, "class_type": "LoadImage",
           "inputs": {"image": "__REFERENCE__"}},
  "unet": {"_meta": {"title": "Load Diffusion Model"}, "class_type": "UNETLoader",
           "inputs": {"unet_name": "qwen_image_2.1_int8_convrot.safetensors", "weight_dtype": "default"}},
  "clip": {"_meta": {"title": "Load CLIP"}, "class_type": "CLIPLoader",
           "inputs": {"clip_name": "qwen3vl_8b_int8_convrot.safetensors", "device": "default", "type": "qwen_image"}},
  "vae": {"_meta": {"title": "Load VAE"}, "class_type": "VAELoader",
          "inputs": {"vae_name": "qwen_image_2.1_vae_bf16.safetensors"}},
  "cache": {"_meta": {"title": "Qwen Image 2.1 Cache"}, "class_type": "QwenImage21Cache",
            "inputs": {"device": "auto", "dtype": "default", "model": ["unet", 0]}},
  "encode": {"_meta": {"title": "Text Encode Qwen Image 2.1"}, "class_type": "TextEncodeQwenImage21",
             "inputs": {"clip": ["clip", 0], "vae": ["vae", 0], "images.image_1": ["load", 0], "resolution": 0,
                        "prompt": "__PROMPT__", "negative_prompt": ""}},
  "latent": {"_meta": {"title": "Empty Latent Image"}, "class_type": "EmptyLatentImage",
             "inputs": {"batch_size": 1, "width": "__WIDTH__", "height": "__HEIGHT__"}},
  "sampler": {"_meta": {"title": "KSampler"}, "class_type": "KSampler",
              "inputs": {"model": ["cache", 0], "positive": ["encode", 0], "negative": ["encode", 1], "latent_image": ["latent", 0],
                         "seed": "__SEED__", "steps": 25, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "denoise": 1}},
  "decode": {"_meta": {"title": "VAE Decode"}, "class_type": "VAEDecode",
             "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]}}
}
